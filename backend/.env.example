APP_NAME=SGHSS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sghss
DB_USERNAME=sghss
# senha padrão para demonstração, troque por uma senha forte
DB_PASSWORD=pgsql@passwrd

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
# senha padrão para demonstração, troque por uma senha forte
REDIS_PASSWORD=redis@passwrd
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=mailpit
# senha padrão para demonstração, troque por uma senha forte
MAIL_PASSWORD=mailpit@passwrd
MAIL_FROM_ADDRESS="vidaplus@sghss.com"
MAIL_FROM_NAME="${APP_NAME}"

# = STORAGE_ACCESS_KEY da raiz
AWS_ACCESS_KEY_ID=sghss-storage
# = STORAGE_SECRET_KEY da raiz; senha padrão para demonstração, troque por uma senha forte
AWS_SECRET_ACCESS_KEY=storage@passwrd
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sghss-private
AWS_ENDPOINT=http://storage:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_BACKUP_BUCKET=sghss-backups

VITE_APP_NAME="${APP_NAME}"

HASH_DRIVER=argon2id
SANCTUM_EXPIRATION=60
# gerar: php -r "echo base64_encode(random_bytes(32));"
BLIND_INDEX_KEY=
JITSI_DOMAIN=localhost:8443
JITSI_APP_ID=sghss
# senha padrão para demonstração, troque por uma senha forte
JITSI_APP_SECRET=jitsi@passwrd
# senha padrão para demonstração, troque por uma senha forte
BACKUP_ARCHIVE_PASSWORD=bckpa03@passwrd
