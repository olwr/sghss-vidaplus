# Copie para backend/.env.production (NUNCA versionar). Valores TROQUE = gerar segredo próprio.
APP_NAME=SGHSS
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show   (GUARDE em cofre: sem ela nada se decifra)
APP_DEBUG=false
APP_URL=https://api.sghss.exemplo.com.br
FRONTEND_URL=https://sghss.exemplo.com.br
APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=stderr_json
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sghss
DB_USERNAME=sghss
DB_PASSWORD=TROQUE            # = POSTGRES_PASSWORD

SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=TROQUE         # = REDIS_PASSWORD
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.exemplo.com.br
MAIL_PORT=587
MAIL_USERNAME=TROQUE
MAIL_PASSWORD=TROQUE
MAIL_FROM_ADDRESS="vidaplus@exemplo.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=TROQUE      # = STORAGE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=TROQUE  # = STORAGE_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sghss-private
AWS_ENDPOINT=http://storage:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_BACKUP_BUCKET=sghss-backups

HASH_DRIVER=argon2id
SANCTUM_EXPIRATION=60
BLIND_INDEX_KEY=TROQUE        # php -r "echo base64_encode(random_bytes(32));"  (GUARDE em cofre; perdê-la = CPFs não localizáveis)
JITSI_DOMAIN=jitsi.exemplo.com.br
JITSI_APP_ID=sghss
JITSI_APP_SECRET=TROQUE
BACKUP_ARCHIVE_PASSWORD=TROQUE
BACKUP_NOTIFY_EMAIL=ti@exemplo.com.br

SGHSS_FUSO_AGENDA=America/Sao_Paulo
SGHSS_RETENCAO_PRONTUARIO_ANOS=20
SGHSS_JITSI_ANTECEDENCIA_MIN=15
SGHSS_JITSI_TOLERANCIA_MIN=30
