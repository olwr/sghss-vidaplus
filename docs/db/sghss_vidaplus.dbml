// =====================================================================
// SGHSS - VidaPlus | Esquema do banco de dados (PostgreSQL)
//
// Convenções (alinhadas ao documento da stack: Laravel + PostgreSQL):
//  - PK interna bigint (bigserial) + coluna `uuid` como identificador
//    público nas rotas da API (evita enumeração).
//  - Multiunidade em um único banco: coluna `unidade_id` + global scope.
//  - Campos "_criptografado" usam o cast `encrypted` do Laravel (tipo text).
//  - "cpf_hash" é o blind index (HMAC-SHA256, chave separada) para busca.
//  - `deleted_at` = SoftDeletes (entidades clínicas / cadastrais).
//  - Enums: implementar como string + PHP Backed Enum (ou enum nativo do PG).
//  - Tabelas de framework sem regra de domínio (jobs, cache, sessions,
//    failed_jobs, migrations, password_resets) ficam de fora de propósito.
// =====================================================================

Project sghss_vidaplus {
  database_type: 'PostgreSQL'
  Note: 'SGHSS VidaPlus - API REST Laravel (monolito modular). Esquema do MVP.'
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------

Enum tipo_unidade {
  hospital
  clinica
  laboratorio
  home_care
}

Enum status_unidade {
  ativa
  desativada
  em_reforma
  em_recesso
}

Enum tipo_profissional {
  medico
  enfermeiro
  tecnico
}

Enum sexo {
  feminino
  masculino
  outro
  nao_informado
}

Enum tipo_agendamento {
  consulta
  exame
}

Enum modalidade_agendamento {
  presencial
  telemedicina
}

Enum status_agendamento {
  agendado
  confirmado
  em_atendimento
  concluido
  cancelado
  remarcado
  faltou
}

Enum status_exame {
  solicitado
  agendado
  realizado
  resultado_disponivel
  cancelado
}

Enum status_receita {
  emitida
  cancelada
}

Enum tipo_leito {
  enfermaria
  apartamento
  uti
}

Enum status_leito {
  disponivel
  ocupado
  manutencao
}

Enum status_internacao {
  solicitada
  ativa
  alta
  cancelada
}

Enum tipo_transferencia {
  paciente
  profissional
}

Enum status_transferencia {
  pendente
  concluida
  cancelada
}

Enum status_sala_telemedicina {
  criada
  em_andamento
  encerrada
  cancelada
}

Enum evento_sessao_telemedicina {
  token_emitido
  verificacao_dispositivo
  entrou
  saiu
}

Enum acao_acesso {
  leitura
  exportacao
  download
}

// ---------------------------------------------------------------------
// MÓDULO: UNIDADES (RF002, RF013, RF014, RNF006)
// ---------------------------------------------------------------------

Table unidades {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  tipo tipo_unidade [not null]
  nome varchar(150) [not null]
  cnpj varchar(14) [unique, note: 'Opcional (ex.: equipes de home care podem usar o CNPJ da matriz)']
  status status_unidade [not null, default: 'ativa']
  telefone varchar(20)
  email varchar(150)
  cep varchar(8)
  logradouro varchar(150)
  numero varchar(10)
  complemento varchar(100)
  bairro varchar(100)
  cidade varchar(100)
  uf char(2)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (tipo, status)
  }

  Note: 'Hospital, clínica, laboratório ou home care. Status controla ativa/desativada/em reforma/em recesso.'
}

Table equipes {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  unidade_id bigint [not null, ref: > unidades.id]
  nome varchar(100) [not null]
  descricao varchar(255)
  ativa boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (unidade_id, nome) [unique]
  }
}

Table equipe_profissionais {
  equipe_id bigint [not null, ref: > equipes.id]
  profissional_id bigint [not null, ref: > profissionais.id]
  funcao varchar(60) [note: 'Papel na equipe (ex.: coordenador, enfermeiro responsável)']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (equipe_id, profissional_id) [pk]
  }
}

// ---------------------------------------------------------------------
// MÓDULO: SEGURANÇA / AUTENTICAÇÃO / AUTORIZAÇÃO (RNF008-RNF010)
// ---------------------------------------------------------------------

Table usuarios {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  unidade_id bigint [ref: >? unidades.id, note: 'Unidade de lotação (secretário/administrador). NULL = acesso global à rede']
  nome varchar(150) [not null]
  email varchar(150) [not null, unique]
  telefone varchar(20)
  password varchar(255) [not null, note: 'Argon2id']
  ativo boolean [not null, default: true, note: 'Desativar revoga os tokens imediatamente']
  email_verificado_em timestamptz
  two_factor_secret_criptografado text [note: 'TOTP. Obrigatório para administradores (pode ficar pós-MVP)']
  two_factor_confirmado_em timestamptz
  ultimo_login_em timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    unidade_id
  }

  Note: 'Conta de login de todos os perfis. O perfil (paciente, secretario, profissional_saude, administrador) vem da tabela model_has_roles (spatie/laravel-permission).'
}

// Laravel Sanctum
Table personal_access_tokens {
  id bigint [pk, increment]
  tokenable_type varchar(255) [not null, note: 'Morph: App\\...\\Usuario']
  tokenable_id bigint [not null, note: 'FK lógica para usuarios.id']
  name varchar(255) [not null]
  token varchar(64) [not null, unique]
  abilities text [note: 'Abilities por perfil']
  last_used_at timestamptz
  expires_at timestamptz [note: 'Expiração curta']
  created_at timestamptz
  updated_at timestamptz

  indexes {
    (tokenable_type, tokenable_id)
  }
}

// spatie/laravel-permission (estrutura padrão do pacote)
Table roles {
  id bigint [pk, increment]
  name varchar(255) [not null]
  guard_name varchar(255) [not null]
  created_at timestamptz
  updated_at timestamptz

  indexes {
    (name, guard_name) [unique]
  }
}

Table permissions {
  id bigint [pk, increment]
  name varchar(255) [not null]
  guard_name varchar(255) [not null]
  created_at timestamptz
  updated_at timestamptz

  indexes {
    (name, guard_name) [unique]
  }
}

Table role_has_permissions {
  permission_id bigint [not null, ref: > permissions.id]
  role_id bigint [not null, ref: > roles.id]

  indexes {
    (permission_id, role_id) [pk]
  }
}

Table model_has_roles {
  role_id bigint [not null, ref: > roles.id]
  model_type varchar(255) [not null, note: 'Morph: App\\...\\Usuario']
  model_id bigint [not null, note: 'FK lógica para usuarios.id']

  indexes {
    (role_id, model_id, model_type) [pk]
    (model_id, model_type)
  }
}

Table model_has_permissions {
  permission_id bigint [not null, ref: > permissions.id]
  model_type varchar(255) [not null]
  model_id bigint [not null, note: 'FK lógica para usuarios.id']

  indexes {
    (permission_id, model_id, model_type) [pk]
    (model_id, model_type)
  }
}

// ---------------------------------------------------------------------
// MÓDULO: PACIENTES (RF001, RNF001)
// ---------------------------------------------------------------------

Table pacientes {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  usuario_id bigint [unique, ref: - usuarios.id, note: 'NULL = paciente cadastrado pela recepção, ainda sem acesso ao app']
  unidade_id bigint [not null, ref: > unidades.id, note: 'Unidade atual (global scope). Transferência = mudar este vínculo']
  nome varchar(150) [not null]
  cpf_criptografado text [not null]
  cpf_hash char(64) [not null, unique, note: 'Blind index (HMAC) para "Buscar paciente" sem expor o CPF']
  data_nascimento date [not null]
  sexo sexo [not null, default: 'nao_informado']
  telefone varchar(20)
  email varchar(150)
  cep varchar(8)
  logradouro varchar(150)
  numero varchar(10)
  complemento varchar(100)
  bairro varchar(100)
  cidade varchar(100)
  uf char(2)
  preferencias_acessibilidade jsonb [note: 'Ex.: {"fonte_ampliada": true, "alto_contraste": true}. Caso de uso "Usar recursos de acessibilidade"']
  anonimizado_em timestamptz [note: 'Preenchido pelo job de retenção/anonimização (LGPD)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    unidade_id
    nome
  }
}

Table paciente_equipes {
  id bigint [pk, increment]
  paciente_id bigint [not null, ref: > pacientes.id]
  equipe_id bigint [not null, ref: > equipes.id]
  inicio_em date [not null]
  fim_em date [note: 'NULL = vínculo ativo']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (paciente_id, fim_em)
    equipe_id
  }

  Note: 'Equipe (ex.: home care) que atende o paciente. Atende "Consultar equipe de home care".'
}

// ---------------------------------------------------------------------
// MÓDULO: PROFISSIONAIS (RF003, RF007)
// ---------------------------------------------------------------------

Table profissionais {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  usuario_id bigint [not null, unique, ref: - usuarios.id, note: 'Nome, e-mail e telefone ficam em usuarios']
  unidade_id bigint [not null, ref: > unidades.id, note: 'Unidade atual. Transferência = mudar este vínculo']
  tipo tipo_profissional [not null]
  especialidade varchar(100)
  conselho_sigla varchar(10) [not null, note: 'CRM, COREN, CRBM...']
  conselho_numero varchar(20) [not null]
  conselho_uf char(2) [not null]
  cpf_criptografado text [not null]
  cpf_hash char(64) [not null, unique]
  ativo boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (conselho_sigla, conselho_numero, conselho_uf) [unique]
    unidade_id
    tipo
  }
}

Table agendas {
  id bigint [pk, increment]
  profissional_id bigint [not null, ref: > profissionais.id]
  unidade_id bigint [not null, ref: > unidades.id]
  dia_semana smallint [not null, note: '0 = domingo ... 6 = sábado']
  hora_inicio time [not null]
  hora_fim time [not null]
  duracao_atendimento_min smallint [not null, default: 30]
  vigencia_inicio date [not null]
  vigencia_fim date
  ativa boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (profissional_id, dia_semana)
    unidade_id
  }

  Note: 'Janelas de disponibilidade semanal do profissional (base para gerar os horários livres). Atende "Gerenciar agenda".'
}

// ---------------------------------------------------------------------
// MÓDULO: AGENDAMENTOS (RF004, RF007)
// ---------------------------------------------------------------------

Table agendamentos {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  tipo tipo_agendamento [not null]
  modalidade modalidade_agendamento [not null, default: 'presencial']
  status status_agendamento [not null, default: 'agendado']
  paciente_id bigint [not null, ref: > pacientes.id]
  profissional_id bigint [ref: >? profissionais.id, note: 'Obrigatório para consulta/telemedicina; opcional para exame de laboratório']
  unidade_id bigint [not null, ref: > unidades.id]
  inicio_em timestamptz [not null]
  fim_em timestamptz [not null]
  motivo varchar(255)
  valor decimal(12,2) [note: 'Valor cobrado pelo atendimento (BRL). NULL = sem cobrança/não informado. Base do relatório financeiro (RF010)']
  retorno_de_id bigint [ref: >? agendamentos.id, note: 'Retorno/exame presencial agendado a partir de um atendimento']
  remarcado_de_id bigint [ref: >? agendamentos.id, note: 'Agendamento original quando houve remarcação']
  criado_por_id bigint [not null, ref: > usuarios.id]
  cancelado_por_id bigint [ref: >? usuarios.id]
  cancelado_em timestamptz
  motivo_cancelamento varchar(255)
  lembrete_enviado_em timestamptz [note: 'Controle do lembrete enviado pela fila/scheduler']
  chave_idempotencia varchar(64) [unique, note: 'Header Idempotency-Key: evita agendamento duplicado por retry']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (profissional_id, inicio_em)
    (paciente_id, inicio_em)
    (unidade_id, inicio_em)
    status
  }

  Note: '''
  Criar via migration (SQL cru), requer a extensão btree_gist:
  ALTER TABLE agendamentos ADD CONSTRAINT agendamentos_sem_sobreposicao
    EXCLUDE USING gist (profissional_id WITH =, tstzrange(inicio_em, fim_em) WITH &&)
    WHERE (profissional_id IS NOT NULL AND status NOT IN ('cancelado','remarcado','faltou'));
  CHECK (fim_em > inicio_em).
  '''
}

// ---------------------------------------------------------------------
// MÓDULO: PRONTUÁRIOS, RECEITAS E EXAMES (RF005, RF006, RF008)
// ---------------------------------------------------------------------

Table prontuarios {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  paciente_id bigint [not null, unique, ref: - pacientes.id]
  tipo_sanguineo varchar(3)
  alergias_criptografado text
  observacoes_gerais_criptografado text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Um prontuário por paciente. Dados clínicos ficam aqui (e não em pacientes) para que a Policy impeça o secretário de ver conteúdo clínico.'
}

Table registros_clinicos {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  prontuario_id bigint [not null, ref: > prontuarios.id]
  profissional_id bigint [not null, ref: > profissionais.id]
  unidade_id bigint [not null, ref: > unidades.id, note: 'Unidade onde o registro foi feito (preserva a origem após transferências)']
  agendamento_id bigint [ref: >? agendamentos.id, note: 'Atendimento que originou o registro (presencial ou telemedicina)']
  queixa_principal_criptografado text
  diagnostico_criptografado text
  conduta_criptografado text
  observacoes_criptografado text
  registrado_em timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (prontuario_id, registrado_em)
    profissional_id
    agendamento_id
  }

  Note: 'Entradas do histórico clínico. Toda alteração é auditada (activity_log) com valores antes/depois.'
}

Table receitas {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  paciente_id bigint [not null, ref: > pacientes.id]
  profissional_id bigint [not null, ref: > profissionais.id]
  unidade_id bigint [not null, ref: > unidades.id]
  registro_clinico_id bigint [ref: >? registros_clinicos.id]
  agendamento_id bigint [ref: >? agendamentos.id]
  status status_receita [not null, default: 'emitida']
  arquivo_path varchar(255) [note: 'PDF no storage S3/MinIO (URL assinada temporária). Assinatura ICP-Brasil: pós-MVP']
  emitida_em timestamptz [not null, default: `now()`]
  cancelada_em timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (paciente_id, emitida_em)
    profissional_id
  }
}

Table receita_itens {
  id bigint [pk, increment]
  receita_id bigint [not null, ref: > receitas.id]
  medicamento varchar(200) [not null]
  dosagem varchar(100)
  posologia varchar(255)
  duracao varchar(100)
  quantidade smallint

  indexes {
    receita_id
  }
}

Table exames {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  paciente_id bigint [not null, ref: > pacientes.id]
  solicitante_id bigint [not null, ref: > profissionais.id]
  unidade_id bigint [ref: >? unidades.id, note: 'Unidade (ex.: laboratório) onde será realizado']
  agendamento_id bigint [unique, ref: - agendamentos.id]
  registro_clinico_id bigint [ref: >? registros_clinicos.id]
  nome varchar(150) [not null]
  instrucoes varchar(255)
  valor decimal(12,2) [note: 'Valor cobrado pelo exame (BRL). NULL = sem cobrança/não informado. Base do relatório financeiro (RF010). Caso o exame seja realizado via agendamento, prevalece sempre o valor definido no Agendamento. Caso seja um exame sem agendamento, prevalece o valor definido em Exame']
  status status_exame [not null, default: 'solicitado']
  solicitado_em timestamptz [not null, default: `now()`]
  realizado_em timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (paciente_id, status)
    unidade_id
  }
}

Table resultados_exames {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  exame_id bigint [not null, ref: > exames.id]
  registrado_por_id bigint [not null, ref: > profissionais.id]
  resumo_criptografado text
  arquivo_path varchar(255) [note: 'Laudo/anexo no storage S3/MinIO, nunca em pasta pública']
  arquivo_nome_original varchar(255)
  arquivo_mime varchar(100)
  arquivo_tamanho bigint
  disponibilizado_em timestamptz [note: 'A partir daqui o paciente enxerga o resultado']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    exame_id
  }
}

// ---------------------------------------------------------------------
// MÓDULO: INTERNAÇÕES E ADMINISTRAÇÃO HOSPITALAR (RF009)
// ---------------------------------------------------------------------

Table leitos {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  unidade_id bigint [not null, ref: > unidades.id]
  codigo varchar(20) [not null]
  setor varchar(100)
  tipo tipo_leito [not null]
  valor_diaria decimal(12,2) [note: 'Valor da diária (BRL). NULL = não definido. Receita de internação = dias internados x valor_diaria (RF010)']
  status status_leito [not null, default: 'disponivel', note: 'Mantido pelo InternacaoService sob lock de linha']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (unidade_id, codigo) [unique]
    (unidade_id, status)
  }
}

Table internacoes {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  paciente_id bigint [not null, ref: > pacientes.id]
  unidade_id bigint [not null, ref: > unidades.id]
  leito_id bigint [ref: >? leitos.id, note: 'NULL enquanto a internação está apenas solicitada']
  solicitante_id bigint [not null, ref: > profissionais.id, note: 'Caso de uso "Solicitar internação"']
  responsavel_id bigint [ref: >? profissionais.id]
  status status_internacao [not null, default: 'solicitada']
  motivo_criptografado text
  solicitada_em timestamptz [not null, default: `now()`]
  admitida_em timestamptz
  alta_em timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (unidade_id, status)
    paciente_id
    leito_id
  }

  Note: '''
  Índices parciais (SQL cru) como última barreira contra leito duplicado:
  CREATE UNIQUE INDEX internacoes_leito_ativo_uq ON internacoes (leito_id) WHERE status = 'ativa';
  CREATE UNIQUE INDEX internacoes_paciente_ativa_uq ON internacoes (paciente_id) WHERE status = 'ativa';
  '''
}

Table suprimentos {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  unidade_id bigint [not null, ref: > unidades.id]
  nome varchar(150) [not null]
  codigo varchar(50)
  unidade_medida varchar(20) [not null, note: 'un, cx, ml, ...']
  quantidade_atual integer [not null, default: 0]
  quantidade_minima integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (unidade_id, nome) [unique]
  }

  Note: 'Suprimentos e estoque por unidade. Alterações de quantidade são rastreadas pelo activity_log.'
}

Table transferencias {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  tipo tipo_transferencia [not null]
  paciente_id bigint [ref: >? pacientes.id]
  profissional_id bigint [ref: >? profissionais.id]
  unidade_origem_id bigint [not null, ref: > unidades.id]
  unidade_destino_id bigint [not null, ref: > unidades.id]
  solicitante_id bigint [not null, ref: > usuarios.id]
  status status_transferencia [not null, default: 'pendente']
  motivo varchar(255)
  efetivada_em timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (unidade_destino_id, status)
    paciente_id
    profissional_id
  }

  Note: '''
  Histórico das transferências (RF014). Ao concluir, o Service atualiza pacientes.unidade_id
  ou profissionais.unidade_id na mesma transação.
  CHECK: (tipo = 'paciente' AND paciente_id IS NOT NULL AND profissional_id IS NULL)
      OR (tipo = 'profissional' AND profissional_id IS NOT NULL AND paciente_id IS NULL)
  CHECK: unidade_origem_id <> unidade_destino_id
  '''
}

// ---------------------------------------------------------------------
// MÓDULO: TELEMEDICINA (RF012, RNF007)
// ---------------------------------------------------------------------

Table telemedicina_salas {
  id bigint [pk, increment]
  uuid uuid [not null, unique]
  agendamento_id bigint [not null, unique, ref: - agendamentos.id]
  nome_sala varchar(100) [not null, unique, note: 'Identificador da sala no Jitsi']
  status status_sala_telemedicina [not null, default: 'criada']
  valida_a_partir_de timestamptz [not null]
  valida_ate timestamptz [not null]
  iniciada_em timestamptz
  encerrada_em timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'A API cria a sala e emite o JWT de curta duração (não armazenado) só para o paciente e o profissional do agendamento, dentro da janela de validade.'
}

Table telemedicina_logs_sessao {
  id bigint [pk, increment]
  sala_id bigint [not null, ref: > telemedicina_salas.id]
  usuario_id bigint [not null, ref: > usuarios.id]
  evento evento_sessao_telemedicina [not null]
  ip varchar(45)
  user_agent varchar(255)
  detalhes jsonb [note: 'Ex.: resultado da verificação de câmera/microfone/rede']
  ocorrido_em timestamptz [not null, default: `now()`]

  indexes {
    (sala_id, ocorrido_em)
    usuario_id
  }

  Note: 'Caso de uso "Registrar log da sessão". Tabela append-only.'
}

// ---------------------------------------------------------------------
// MÓDULO: AUDITORIA E LGPD (RNF010, RNF011)
// ---------------------------------------------------------------------

// Estrutura do spatie/laravel-activitylog (+ ip_address e user_agent)
Table activity_log {
  id bigint [pk, increment]
  log_name varchar(255)
  description text [not null]
  subject_type varchar(255) [note: 'Morph: entidade alterada']
  subject_id bigint
  event varchar(255) [note: 'created, updated, deleted...']
  causer_type varchar(255) [note: 'Morph: quem fez (Usuario)']
  causer_id bigint
  properties jsonb [note: 'Valores antes/depois (old / attributes)']
  batch_uuid uuid
  ip_address varchar(45)
  user_agent varchar(255)
  created_at timestamptz
  updated_at timestamptz

  indexes {
    log_name
    (subject_type, subject_id)
    (causer_type, causer_id)
    created_at
  }

  Note: 'Auditoria de escrita. Append-only: REVOKE UPDATE, DELETE para o usuário da aplicação.'
}

Table logs_acesso {
  id bigint [pk, increment]
  usuario_id bigint [not null, ref: > usuarios.id]
  unidade_id bigint [ref: >? unidades.id]
  paciente_id bigint [ref: >? pacientes.id, note: 'Paciente cujos dados foram acessados (facilita "quem acessou o quê")']
  acao acao_acesso [not null]
  recurso_tipo varchar(100) [not null, note: 'prontuario, resultado_exame, exportacao...']
  recurso_id bigint
  ip varchar(45)
  user_agent varchar(255)
  rota varchar(255)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (usuario_id, created_at)
    (paciente_id, created_at)
    (recurso_tipo, recurso_id)
  }

  Note: 'Auditoria de LEITURA e exportação de dados sensíveis (middleware/listeners). Append-only.'
}

Table consentimentos {
  id bigint [pk, increment]
  paciente_id bigint [not null, ref: > pacientes.id]
  finalidade varchar(150) [not null, note: 'Finalidade do tratamento']
  versao_termo varchar(20) [not null]
  concedido_em timestamptz [not null]
  revogado_em timestamptz
  ip_origem varchar(45)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (paciente_id, finalidade)
  }
}

// ---------------------------------------------------------------------
// GRUPOS (organização visual no dbdiagram.io)
// ---------------------------------------------------------------------

TableGroup modulo_unidades {
  unidades
  equipes
  equipe_profissionais
}

TableGroup modulo_seguranca {
  usuarios
  personal_access_tokens
  roles
  permissions
  role_has_permissions
  model_has_roles
  model_has_permissions
}

TableGroup modulo_pacientes {
  pacientes
  paciente_equipes
}

TableGroup modulo_profissionais {
  profissionais
  agendas
}

TableGroup modulo_agendamentos {
  agendamentos
}

TableGroup modulo_prontuarios {
  prontuarios
  registros_clinicos
  receitas
  receita_itens
  exames
  resultados_exames
}

TableGroup modulo_internacoes_administracao {
  leitos
  internacoes
  suprimentos
  transferencias
}

TableGroup modulo_telemedicina {
  telemedicina_salas
  telemedicina_logs_sessao
}

TableGroup modulo_auditoria_lgpd {
  activity_log
  logs_acesso
  consentimentos
}
